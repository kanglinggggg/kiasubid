DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The default database is <project>/data/bidops.db. Override DATABASE_URL only when needed.

# Select exactly one live interpretation provider. Empty credentials/model IDs keep the
# clearly labelled canonical demo fallback active.
LLM_PROVIDER=bedrock
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
# Paste temporary lease credentials locally only. They expire approximately every 12 hours.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=
BEDROCK_STRUCTURED_OUTPUT=true

# Temporary local live-model validation option. Do not commit the API key.
GROQ_API_KEY=
# GROQ_MODEL is accepted as an alias for teams that use the provider's common variable name.
GROQ_MODEL_ID=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STRUCTURED_OUTPUT=true
GROQ_TIMEOUT_SECONDS=60

LLM_MAX_RETRIES=1
